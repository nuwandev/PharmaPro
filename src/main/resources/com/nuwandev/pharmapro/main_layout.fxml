<?xml version="1.0" encoding="UTF-8"?>

<!--
    PharmaPro - Main Application Shell
    Controller: com.nuwandev.pharmapro.ui.MainLayoutController
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainRoot" minHeight="700" minWidth="1200" prefHeight="1000"
            prefWidth="1600" stylesheets="@css/pharmapro.css"
            xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.nuwandev.pharmapro.ui.MainLayoutController">

    <left>
        <VBox fx:id="sidebar" spacing="0" styleClass="sidebar">

            <!-- Brand -->
            <HBox fx:id="sidebarBrand" alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-brand">
                <StackPane prefHeight="40" prefWidth="40" styleClass="sidebar-brand-icon">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Rx"/>
                </StackPane>
                <VBox spacing="3">
                    <Label styleClass="sidebar-brand-name" text="PharmaPro"/>
                    <Label styleClass="sidebar-brand-tagline" text="POS &amp; Inventory"/>
                </VBox>
            </HBox>

            <!-- Nav -->
            <ScrollPane fx:id="sidebarScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="navContainer" spacing="2"
                      style="-fx-padding: 16px 12px 12px 12px; -fx-background-color: transparent;">

                    <Label style="-fx-padding: 0 4px 6px 4px;" styleClass="sidebar-section-label" text="MAIN"/>

                    <Button fx:id="navDashboard" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToDashboard"
                            styleClass="nav-item, nav-item-active" text="  Dashboard">
                        <tooltip><Tooltip text="Dashboard"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="🏠"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navPOS" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToPOS"
                            styleClass="nav-item" text="  Point of Sale">
                        <tooltip><Tooltip text="Point of Sale"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="🛒"/>
                        </graphic>
                    </Button>

                    <Label style="-fx-padding: 14px 4px 6px 4px;" styleClass="sidebar-section-label" text="INVENTORY"/>

                    <Button fx:id="navMedicines" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToMedicines"
                            styleClass="nav-item" text="  Medicines">
                        <tooltip><Tooltip text="Medicines"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="💊"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navBatches" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToBatches"
                            styleClass="nav-item" text="  Batch Management">
                        <tooltip><Tooltip text="Batch Management"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="📦"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navPurchaseOrders" graphicTextGap="10" maxWidth="Infinity"
                            onAction="#navigateToPurchaseOrders" styleClass="nav-item" text="  Purchase Orders">
                        <tooltip><Tooltip text="Purchase Orders"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="📋"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navSuppliers" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToSuppliers"
                            styleClass="nav-item" text="  Suppliers">
                        <tooltip><Tooltip text="Suppliers"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="🏭"/>
                        </graphic>
                    </Button>

                    <Label style="-fx-padding: 14px 4px 6px 4px;" styleClass="sidebar-section-label"
                           text="REPORTS &amp; SETTINGS"/>

                    <Button fx:id="navReports" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToReports"
                            styleClass="nav-item" text="  Reports">
                        <tooltip><Tooltip text="Reports"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="📊"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navSettings" graphicTextGap="10" maxWidth="Infinity" onAction="#navigateToSettings"
                            styleClass="nav-item" text="  Settings">
                        <tooltip><Tooltip text="Settings"/></tooltip>
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="⚙"/>
                        </graphic>
                    </Button>

                </VBox>
            </ScrollPane>

            <!-- Footer -->
            <HBox fx:id="sidebarFooter" alignment="CENTER_LEFT" onMouseClicked="#showSidebarUserMenu" spacing="10"
                  styleClass="sidebar-footer">
                <StackPane styleClass="user-avatar">
                    <Label fx:id="sidebarUserInitials"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" text="AU"/>
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserName"
                           style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #e5e7eb;"
                           text="Admin User"/>
                    <Label fx:id="sidebarUserRole" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"
                           text="Administrator"/>
                </VBox>
                <Button fx:id="logoutBtn" onAction="#handleLogout" style="-fx-text-fill: #6b7280; -fx-font-size: 16px;"
                        styleClass="btn-icon" text="⇥">
                    <tooltip>
                        <Tooltip text="Logout"/>
                    </tooltip>
                </Button>
            </HBox>

        </VBox>
    </left>

    <center>
        <VBox>

            <!-- TOPBAR -->
            <HBox fx:id="topbar" alignment="CENTER_LEFT" spacing="16" styleClass="topbar">

                <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="topbarPageTitle" styleClass="topbar-page-title" text="Dashboard"/>
                    <Label fx:id="topbarBreadcrumb" styleClass="caption-text" text="Home / Dashboard"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search -->
                <StackPane alignment="CENTER_LEFT" prefWidth="260">
                    <TextField fx:id="globalSearchField" promptText="Quick search..."
                               style="-fx-padding: 8px 14px 8px 36px;" styleClass="topbar-search"/>
                    <Label mouseTransparent="true"
                           style="-fx-padding: 0 0 0 12px; -fx-font-size: 13px; -fx-text-fill: #9ca3af;" text="🔍"/>
                </StackPane>

                <!-- Bell + badge -->
                <StackPane alignment="TOP_RIGHT" prefHeight="44" prefWidth="44">
                    <Button fx:id="notificationBtn" onAction="#showNotifications" styleClass="notif-btn"
                            StackPane.alignment="CENTER">
                        <graphic>
                            <Label style="-fx-font-size: 20px;" text="🔔"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Notifications"/>
                        </tooltip>
                    </Button>
                    <Label fx:id="notifBadge" style="-fx-translate-x: 2px; -fx-translate-y: 2px;"
                           styleClass="notif-badge" text="3" visible="true" StackPane.alignment="TOP_RIGHT"/>
                </StackPane>


            </HBox>

            <!-- CONTENT AREA -->
            <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS">
                <Label fx:id="contentPlaceholder" styleClass="muted-text" text="Loading..."/>
            </StackPane>

        </VBox>
    </center>

    <!-- TOAST -->
    <top>
        <StackPane fx:id="toastContainer" alignment="TOP_RIGHT" managed="false" mouseTransparent="true"
                   style="-fx-padding: 24px 24px 0 0;" visible="false">
            <VBox fx:id="toastBox" spacing="8"
                  style="-fx-background-color: white; -fx-background-radius: 10px;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 16, 0, 0, 4);                          -fx-padding: 14px 18px; -fx-max-width: 300px;                          -fx-border-color: #e5e7eb; -fx-border-width: 1px; -fx-border-radius: 10px;">
                <Label fx:id="toastMessage" styleClass="body-text" text="Operation completed" wrapText="true"/>
            </VBox>
        </StackPane>
    </top>

</BorderPane>
