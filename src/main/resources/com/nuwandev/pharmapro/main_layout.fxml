<?xml version="1.0" encoding="UTF-8"?>

<!--
    PharmaPro – Main Application Shell
    Sidebar + Topbar + Content Area
    Controller: com.nuwandev.pharmapro.ui.MainLayoutController
-->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        xmlns="http://javafx.com/javafx/17"
        fx:controller="com.nuwandev.pharmapro.ui.MainLayoutController"
        fx:id="mainRoot"
        stylesheets="@css/pharmapro.css"
        prefWidth="1600" prefHeight="1000"
        minWidth="1200" minHeight="700">

    <!-- ══════════════════════════════════════════════
         LEFT SIDEBAR
    ══════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar"
              spacing="0">

            <!-- Brand / Logo -->
            <HBox fx:id="sidebarBrand"
                  styleClass="sidebar-brand"
                  alignment="CENTER_LEFT"
                  spacing="12">
                <StackPane styleClass="sidebar-brand-icon"
                           prefWidth="40" prefHeight="40">
                    <!-- Logo placeholder -->
                    <Label text="Rx"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="PharmaPro"
                           styleClass="sidebar-brand-name"/>
                    <Label text="POS &amp; Inventory"
                           styleClass="sidebar-brand-tagline"/>
                </VBox>
            </HBox>

            <!-- Navigation Items (ScrollPane for overflow) -->
            <ScrollPane fx:id="sidebarScrollPane"
                        VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox fx:id="navContainer"
                      spacing="2"
                      style="-fx-padding: 12px 16px 12px 16px; -fx-background-color: transparent;">

                    <!-- MAIN SECTION -->
                    <Label text="MAIN" styleClass="sidebar-section-label"
                           style="-fx-padding: 4px 4px 6px 4px;"/>

                    <Button fx:id="navDashboard"
                            text="Dashboard"
                            styleClass="nav-item, nav-item-active"
                            onAction="#navigateToDashboard"
                            maxWidth="Infinity">
                        <graphic>
                            <!-- Icon placeholder: replace with FontAwesome or SVG icon -->
                            <Label text="⊞"
                                   style="-fx-font-size: 16px; -fx-text-fill: inherit;"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navPOS"
                            text="Point of Sale"
                            styleClass="nav-item"
                            onAction="#navigateToPOS"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="🛒" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                    <!-- INVENTORY SECTION -->
                    <Label text="INVENTORY"
                           styleClass="sidebar-section-label"
                           style="-fx-padding: 16px 4px 6px 4px;"/>

                    <Button fx:id="navMedicines"
                            text="Medicines"
                            styleClass="nav-item"
                            onAction="#navigateToMedicines"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="💊" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navBatches"
                            text="Batch Management"
                            styleClass="nav-item"
                            onAction="#navigateToBatches"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="📦" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navPurchaseOrders"
                            text="Purchase Orders"
                            styleClass="nav-item"
                            onAction="#navigateToPurchaseOrders"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="📋" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navSuppliers"
                            text="Suppliers"
                            styleClass="nav-item"
                            onAction="#navigateToSuppliers"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="🏭" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                    <!-- REPORTS SECTION -->
                    <Label text="REPORTS &amp; SETTINGS"
                           styleClass="sidebar-section-label"
                           style="-fx-padding: 16px 4px 6px 4px;"/>

                    <Button fx:id="navReports"
                            text="Reports"
                            styleClass="nav-item"
                            onAction="#navigateToReports"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="📊" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                    <Button fx:id="navSettings"
                            text="Settings"
                            styleClass="nav-item"
                            onAction="#navigateToSettings"
                            maxWidth="Infinity">
                        <graphic>
                            <Label text="⚙" style="-fx-font-size: 15px;"/>
                        </graphic>
                    </Button>

                </VBox>
            </ScrollPane>

            <!-- Sidebar Footer: User info + Logout -->
            <VBox fx:id="sidebarFooter"
                  styleClass="sidebar-footer"
                  spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="sidebarUserInitials"
                               text="AK"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label fx:id="sidebarUserName"
                               text="Admin User"
                               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #e5e7eb;"/>
                        <Label fx:id="sidebarUserRole"
                               text="Administrator"
                               style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                    </VBox>
                     <Button fx:id="logoutBtn"
                             text="⇥"
                             styleClass="btn-icon"
                             style="-fx-text-fill: #6b7280; -fx-font-size: 16px;"
                             onAction="#handleLogout">
                        <tooltip>
                            <Tooltip text="Logout"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════
         CENTER: Topbar + Main Content
    ══════════════════════════════════════════════ -->
    <center>
        <VBox>

            <!-- TOP BAR -->
            <HBox fx:id="topbar"
                  styleClass="topbar"
                  alignment="CENTER_LEFT"
                  spacing="16">

                <!-- Page Title (updated dynamically) -->
                <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="2">
                    <Label fx:id="topbarPageTitle"
                           text="Dashboard"
                           styleClass="topbar-page-title"/>
                    <Label fx:id="topbarBreadcrumb"
                           text="Home / Dashboard"
                           styleClass="caption-text"/>
                </VBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Global Search -->
                <StackPane alignment="CENTER_LEFT">
                    <TextField fx:id="globalSearchField"
                               styleClass="topbar-search"
                               promptText="Quick search…"/>
                    <Label text="🔍"
                           style="-fx-padding: 0 0 0 10px; -fx-font-size: 14px; -fx-text-fill: #9ca3af;"
                           mouseTransparent="true"/>
                </StackPane>

                <!-- Notifications Bell -->
                <StackPane alignment="TOP_RIGHT">
                    <Button fx:id="notificationBtn"
                            styleClass="notif-btn"
                            onAction="#showNotifications">
                        <graphic>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Notifications"/>
                        </tooltip>
                    </Button>
                    <Label fx:id="notifBadge"
                           text="3"
                           styleClass="notif-badge"
                           translateX="10"
                           translateY="-8"
                           visible="true"/>
                </StackPane>

                <!-- Divider -->
                <Separator orientation="VERTICAL" prefHeight="32" opacity="0.3"/>

                <!-- User Profile -->
                <HBox alignment="CENTER" spacing="10"
                      style="-fx-cursor: hand; -fx-padding: 4px 8px; -fx-background-radius: 8px;"
                      fx:id="userProfileBox"
                      onMouseClicked="#showUserMenu">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="topbarUserInitials"
                               text="AK"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label fx:id="topbarUserName"
                               text="Admin User"
                               styleClass="user-name-label"/>
                        <Label fx:id="topbarUserRole"
                               text="Administrator"
                               styleClass="user-role-label"/>
                    </VBox>
                    <Label text="▾"
                           style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                </HBox>

            </HBox>

            <!-- MAIN CONTENT AREA (dynamic screen injection) -->
            <StackPane fx:id="contentArea"
                       VBox.vgrow="ALWAYS"
                       styleClass="content-area"
                       style="-fx-background-color: #f5f5f5;">
                <!-- Screens are loaded here dynamically by MainLayoutController -->
                <Label text="Loading…"
                       styleClass="muted-text"
                       fx:id="contentPlaceholder"/>
            </StackPane>

        </VBox>
    </center>

    <!-- ══════════════════════════════════════════════
         OVERLAY (modals, drawers, toasts)
    ══════════════════════════════════════════════ -->
    <!-- Notification popup (toggled programmatically) -->
    <top>
        <StackPane fx:id="toastContainer"
                   alignment="TOP_RIGHT"
                   managed="false"
                   visible="false"
                   style="-fx-padding: 70px 24px 0 0;"
                   mouseTransparent="true">
            <VBox fx:id="toastBox"
                  spacing="8"
                  style="-fx-background-color: white; -fx-background-radius: 10px;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 16, 0, 0, 4);
                         -fx-padding: 12px 16px; -fx-max-width: 300px;">
                <Label fx:id="toastMessage"
                       text="Operation completed"
                       styleClass="body-text"
                       wrapText="true"/>
            </VBox>
        </StackPane>
    </top>

</BorderPane>
