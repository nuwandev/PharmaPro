<?xml version="1.0" encoding="UTF-8"?>

<!--
    PharmaPro – Settings Screen
    Tabs: General | Reorder Rules | Receipt Template | Users & Access
    Controller: com.nuwandev.pharmapro.ui.SettingsController
-->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox
        xmlns:fx="http://javafx.com/fxml/1"
        xmlns="http://javafx.com/javafx/17"
        fx:controller="com.nuwandev.pharmapro.ui.SettingsController"
        fx:id="settingsRoot"
        spacing="0"
        style="-fx-background-color: #f5f5f5;"
        stylesheets="@css/pharmapro.css">

    <!-- ── Settings Header ──────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-padding: 0 0 20px 0;">
        <VBox HBox.hgrow="ALWAYS" spacing="3">
            <Label text="Settings" styleClass="title-medium"/>
            <Label text="Manage system configuration, users, and preferences."
                   styleClass="caption-text"/>
        </VBox>
        <Button fx:id="saveAllSettingsBtn"
                text="💾  Save All Changes"
                styleClass="btn-primary"
                onAction="#saveAllSettings"/>
    </HBox>

    <!-- ── Tab Pane ─────────────────────────────────────────── -->
    <TabPane fx:id="settingsTabPane"
             styleClass="tab-pane"
             VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE">

        <!-- ══════════════════════════════════════════════════
             TAB 1 – GENERAL
        ══════════════════════════════════════════════════ -->
        <Tab fx:id="generalTab" text="⚙  General">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 20px 0;">

                    <!-- Pharmacy Info -->
                    <VBox styleClass="settings-section" spacing="16">
                        <Label text="Pharmacy Information" styleClass="title-small"/>
                        <Separator opacity="0.4"/>

                        <GridPane hgap="20" vgap="14" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Pharmacy Name *" styleClass="form-label"/>
                                <TextField fx:id="pharmacyNameField"
                                           styleClass="form-field"
                                           promptText="PharmaPro Pharmacy"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="License Number" styleClass="form-label"/>
                                <TextField fx:id="licenseNumberField"
                                           styleClass="form-field"
                                           promptText="PH-000000"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Phone Number" styleClass="form-label"/>
                                <TextField fx:id="pharmacyPhoneField"
                                           styleClass="form-field"
                                           promptText="+1 (555) 000-0000"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Email" styleClass="form-label"/>
                                <TextField fx:id="pharmacyEmailField"
                                           styleClass="form-field"
                                           promptText="info@pharmacy.com"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                  GridPane.columnSpan="2">
                                <Label text="Address" styleClass="form-label"/>
                                <TextArea fx:id="pharmacyAddressField"
                                          styleClass="form-textarea"
                                          promptText="Full address"
                                          wrapText="true"
                                          prefRowCount="2"/>
                            </VBox>

                        </GridPane>
                    </VBox>

                    <!-- Currency & Regional -->
                    <VBox styleClass="settings-section" spacing="16">
                        <Label text="Regional &amp; Currency" styleClass="title-small"/>
                        <Separator opacity="0.4"/>

                        <GridPane hgap="20" vgap="14" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Currency" styleClass="form-label"/>
                                <ComboBox fx:id="currencyCombo"
                                          styleClass="combo-box"
                                          maxWidth="Infinity" prefHeight="42"
                                          value="USD ($)"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Date Format" styleClass="form-label"/>
                                <ComboBox fx:id="dateFormatCombo"
                                          styleClass="combo-box"
                                          maxWidth="Infinity" prefHeight="42"
                                          value="MM/dd/yyyy"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Timezone" styleClass="form-label"/>
                                <ComboBox fx:id="timezoneCombo"
                                          styleClass="combo-box"
                                          maxWidth="Infinity" prefHeight="42"
                                          promptText="Select timezone"
                                          editable="true"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Default Tax Rate (%)" styleClass="form-label"/>
                                <TextField fx:id="defaultTaxRateField"
                                           styleClass="form-field"
                                           promptText="0"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Decimal Places" styleClass="form-label"/>
                                <ComboBox fx:id="decimalPlacesCombo"
                                          styleClass="combo-box"
                                          maxWidth="Infinity" prefHeight="42"
                                          value="2"/>
                            </VBox>

                        </GridPane>
                    </VBox>

                    <!-- System Preferences -->
                    <VBox styleClass="settings-section" spacing="16">
                        <Label text="System Preferences" styleClass="title-small"/>
                        <Separator opacity="0.4"/>

                        <GridPane hgap="20" vgap="16" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <CheckBox fx:id="autoPrintReceiptCheck"
                                          text="Auto-print receipt after sale"
                                          style="-fx-font-size: 14px;"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <CheckBox fx:id="requirePrescriptionCheck"
                                          text="Require prescription confirmation"
                                          style="-fx-font-size: 14px;"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <CheckBox fx:id="enableBarcodeCheck"
                                          text="Enable barcode scanner input"
                                          style="-fx-font-size: 14px;"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <CheckBox fx:id="showExpiringAlertCheck"
                                          text="Show dashboard expiry alerts"
                                          style="-fx-font-size: 14px;"
                                          selected="true"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <CheckBox fx:id="enableSoundCheck"
                                          text="Enable sound notifications"
                                          style="-fx-font-size: 14px;"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <CheckBox fx:id="darkModeCheck"
                                          text="Dark mode (experimental)"
                                          style="-fx-font-size: 14px;"/>
                            </HBox>

                        </GridPane>

                        <!-- Expiry Warning Days -->
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <Label text="Expiry warning threshold:" styleClass="form-label"/>
                            <Spinner fx:id="expiryWarningDaysSpinner"
                                     styleClass="spinner"
                                     prefWidth="100" prefHeight="42"
                                     editable="true"/>
                            <Label text="days before expiry" styleClass="body-text"/>
                        </HBox>

                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════════════════════════════════════
             TAB 2 – REORDER RULES
        ══════════════════════════════════════════════════ -->
        <Tab fx:id="reorderTab" text="📉  Reorder Rules">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 20px 0;">

                    <!-- Global Reorder Settings -->
                    <VBox styleClass="settings-section" spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <Label text="Global Reorder Defaults"
                                   styleClass="title-small"
                                   HBox.hgrow="ALWAYS"/>
                            <Label text="These apply unless a medicine has a custom level."
                                   styleClass="caption-text"/>
                        </HBox>
                        <Separator opacity="0.4"/>

                        <GridPane hgap="20" vgap="14" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Default Reorder Level" styleClass="form-label"/>
                                <Spinner fx:id="defaultReorderLevelSpinner"
                                         styleClass="spinner"
                                         prefHeight="42" maxWidth="Infinity"
                                         editable="true"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Default Reorder Quantity" styleClass="form-label"/>
                                <Spinner fx:id="defaultReorderQtySpinner"
                                         styleClass="spinner"
                                         prefHeight="42" maxWidth="Infinity"
                                         editable="true"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Alert Method" styleClass="form-label"/>
                                <ComboBox fx:id="alertMethodCombo"
                                          styleClass="combo-box"
                                          maxWidth="Infinity" prefHeight="42"
                                          value="Dashboard Only"/>
                            </VBox>

                        </GridPane>
                    </VBox>

                    <!-- Per-Category Rules Table -->
                    <VBox styleClass="settings-section" spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <Label text="Per-Category Reorder Rules"
                                   styleClass="title-small"
                                   HBox.hgrow="ALWAYS"/>
                            <Button fx:id="addCategoryRuleBtn"
                                    text="＋ Add Rule"
                                    styleClass="btn-primary, btn-small"
                                    onAction="#addCategoryRule"/>
                        </HBox>
                        <Separator opacity="0.4"/>

                        <TableView fx:id="reorderRulesTable"
                                   styleClass="table-view"
                                   prefHeight="260"
                                   placeholder="No custom rules. Using global defaults.">
                            <columns>
                                <TableColumn fx:id="ruleCategoryCol"
                                             text="CATEGORY" prefWidth="180"/>
                                <TableColumn fx:id="ruleReorderLevelCol"
                                             text="REORDER LEVEL" prefWidth="140"
                                             editable="true"/>
                                <TableColumn fx:id="ruleReorderQtyCol"
                                             text="REORDER QTY" prefWidth="130"
                                             editable="true"/>
                                <TableColumn fx:id="ruleAlertMethodCol"
                                             text="ALERT METHOD" prefWidth="140"/>
                                <TableColumn fx:id="ruleActionsCol"
                                             text="" prefWidth="80"
                                             sortable="false" resizable="false"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════════════════════════════════════════════════
             TAB 3 – RECEIPT TEMPLATE
        ══════════════════════════════════════════════════ -->
        <Tab fx:id="receiptTab" text="🧾  Receipt Template">
            <HBox spacing="20" style="-fx-padding: 20px 0;">

                <!-- Left: Template Config -->
                <VBox styleClass="settings-section"
                      spacing="16"
                      HBox.hgrow="ALWAYS"
                      maxWidth="480">
                    <Label text="Receipt Configuration" styleClass="title-small"/>
                    <Separator opacity="0.4"/>

                    <VBox spacing="4">
                        <Label text="Header Title" styleClass="form-label"/>
                        <TextField fx:id="receiptHeaderField"
                                   styleClass="form-field"
                                   promptText="Your Pharmacy Name"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Sub-header / Tagline" styleClass="form-label"/>
                        <TextField fx:id="receiptSubHeaderField"
                                   styleClass="form-field"
                                   promptText="Your health, our priority"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Footer Message" styleClass="form-label"/>
                        <TextArea fx:id="receiptFooterField"
                                  styleClass="form-textarea"
                                  promptText="Thank you for your purchase! Please keep this receipt."
                                  wrapText="true"
                                  prefRowCount="3"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Receipt Paper Width" styleClass="form-label"/>
                        <ComboBox fx:id="receiptWidthCombo"
                                  styleClass="combo-box"
                                  maxWidth="Infinity" prefHeight="42"
                                  value="80mm (Standard)"/>
                    </VBox>

                    <Separator opacity="0.4"/>

                    <VBox spacing="10">
                        <Label text="Show on Receipt:" styleClass="form-label"/>
                        <CheckBox fx:id="showLogoCheck"
                                  text="Show pharmacy logo"
                                  style="-fx-font-size: 14px;" selected="true"/>
                        <CheckBox fx:id="showAddressCheck"
                                  text="Show pharmacy address"
                                  style="-fx-font-size: 14px;" selected="true"/>
                        <CheckBox fx:id="showPhoneCheck"
                                  text="Show pharmacy phone"
                                  style="-fx-font-size: 14px;" selected="true"/>
                        <CheckBox fx:id="showBatchOnReceiptCheck"
                                  text="Show batch number"
                                  style="-fx-font-size: 14px;"/>
                        <CheckBox fx:id="showExpiryOnReceiptCheck"
                                  text="Show expiry date"
                                  style="-fx-font-size: 14px;" selected="true"/>
                        <CheckBox fx:id="showCashierNameCheck"
                                  text="Show cashier name"
                                  style="-fx-font-size: 14px;" selected="true"/>
                        <CheckBox fx:id="showBarCodeCheck"
                                  text="Print barcode on receipt"
                                  style="-fx-font-size: 14px;"/>
                    </VBox>

                </VBox>

                <!-- Right: Preview -->
                <VBox styleClass="settings-section"
                      spacing="12"
                      HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="Receipt Preview"
                               styleClass="title-small"
                               HBox.hgrow="ALWAYS"/>
                        <Button fx:id="printTestReceiptBtn"
                                text="🖨 Print Test"
                                styleClass="btn-secondary, btn-small"
                                onAction="#printTestReceipt"/>
                    </HBox>
                    <Separator opacity="0.4"/>

                    <!-- Receipt Preview Box -->
                    <StackPane fx:id="receiptPreviewContainer"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                      -fx-border-width: 1px; -fx-border-radius: 6px;
                                      -fx-background-radius: 6px;">
                        <VBox fx:id="receiptPreviewBox"
                              spacing="4"
                              alignment="TOP_CENTER"
                              style="-fx-padding: 16px 12px;
                                     -fx-background-color: white;
                                     -fx-border-color: #e5e7eb;
                                     -fx-border-width: 1px;
                                     -fx-max-width: 300px;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);
                                     -fx-font-family: 'Courier New', monospace;
                                     -fx-font-size: 12px;">

                            <Label fx:id="previewHeader"
                                   text="PHARMAPRO PHARMACY"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: center;"
                                   maxWidth="Infinity" alignment="CENTER"/>
                            <Label fx:id="previewSubHeader"
                                   text="Your health, our priority"
                                   style="-fx-font-size: 11px;"
                                   maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="123 Health St, City, ST 00000"
                                   style="-fx-font-size: 11px;"
                                   maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="Tel: (555) 000-0000"
                                   style="-fx-font-size: 11px;"
                                   maxWidth="Infinity" alignment="CENTER"/>
                            <Separator style="-fx-padding: 4px 0;"/>
                            <Label text="Receipt: SL-000001"
                                   style="-fx-font-size: 11px;"/>
                            <Label text="Date: 01/01/2025  10:00 AM"
                                   style="-fx-font-size: 11px;"/>
                            <Label text="Cashier: Admin User"
                                   style="-fx-font-size: 11px;"/>
                            <Separator style="-fx-padding: 4px 0;"/>
                            <Label text="Paracetamol 500mg    $2.50"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 11px;"/>
                            <Label text="Amoxicillin 250mg    $5.00"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 11px;"/>
                            <Separator style="-fx-padding: 4px 0;"/>
                            <Label text="Subtotal:      $7.50"
                                   maxWidth="Infinity" alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 11px;"/>
                            <Label text="Tax (5%):      $0.38"
                                   maxWidth="Infinity" alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 11px;"/>
                            <Label text="TOTAL:         $7.88"
                                   maxWidth="Infinity" alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <Label text="Cash Paid:     $10.00"
                                   maxWidth="Infinity" alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 11px;"/>
                            <Label text="Change:         $2.12"
                                   maxWidth="Infinity" alignment="CENTER_RIGHT"
                                   style="-fx-font-size: 11px;"/>
                            <Separator style="-fx-padding: 4px 0;"/>
                            <Label fx:id="previewFooter"
                                   text="Thank you for your purchase!"
                                   wrapText="true"
                                   maxWidth="Infinity" alignment="CENTER"
                                   style="-fx-font-size: 11px;"/>

                        </VBox>
                    </StackPane>

                </VBox>

            </HBox>
        </Tab>

        <!-- ══════════════════════════════════════════════════
             TAB 4 – USERS & ACCESS
        ══════════════════════════════════════════════════ -->
        <Tab fx:id="usersTab" text="👤  Users &amp; Access">
            <StackPane>
                <VBox spacing="0" style="-fx-padding: 20px 0 0 0;">

                    <!-- Toolbar -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-padding: 0 0 16px 0;">
                        <StackPane alignment="CENTER_LEFT">
                            <TextField fx:id="userSearchField"
                                       styleClass="search-field"
                                       promptText="Search users…"
                                       prefWidth="260"/>
                            <Label text="🔍"
                                   style="-fx-padding: 0 0 0 10px; -fx-font-size: 13px; -fx-text-fill: #9ca3af;"
                                   mouseTransparent="true"/>
                        </StackPane>

                        <ComboBox fx:id="userRoleFilterCombo"
                                  styleClass="combo-box"
                                  promptText="All Roles"
                                  prefWidth="140" prefHeight="42"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="addUserBtn"
                                text="＋  Add User"
                                styleClass="btn-primary"
                                onAction="#openAddUser"/>
                    </HBox>

                    <!-- Users Table -->
                    <VBox styleClass="settings-section" spacing="0">
                        <TableView fx:id="usersTable"
                                   styleClass="table-view"
                                   prefHeight="380"
                                   placeholder="No users found.">
                            <columns>
                                <TableColumn fx:id="userAvatarCol"
                                             text=""
                                             maxWidth="44" minWidth="44"
                                             sortable="false" resizable="false"/>
                                <TableColumn fx:id="userFullNameCol"
                                             text="FULL NAME" prefWidth="180"/>
                                <TableColumn fx:id="userUsernameCol"
                                             text="USERNAME" prefWidth="140"/>
                                <TableColumn fx:id="userEmailCol"
                                             text="EMAIL" prefWidth="200"/>
                                <TableColumn fx:id="userRoleCol"
                                             text="ROLE" prefWidth="130"/>
                                <TableColumn fx:id="userLastLoginCol"
                                             text="LAST LOGIN" prefWidth="150"/>
                                <TableColumn fx:id="userStatusCol"
                                             text="STATUS" prefWidth="100"/>
                                <TableColumn fx:id="userActionsCol"
                                             text="ACTIONS" prefWidth="140"
                                             sortable="false" resizable="false"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>

                <!-- ══ ADD/EDIT USER MODAL ══════════════════════════ -->
                <StackPane fx:id="userModalOverlay"
                           styleClass="modal-overlay"
                           visible="false"
                           managed="false">

                    <VBox fx:id="userDialog"
                          styleClass="modal-dialog"
                          spacing="0"
                          maxWidth="520">

                        <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="0">
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label fx:id="userModalTitle"
                                       text="Add New User"
                                       styleClass="title-small"/>
                            </VBox>
                            <Button fx:id="closeUserModalBtn"
                                    text="✕"
                                    styleClass="drawer-close-btn"
                                    onAction="#closeUserModal"/>
                        </HBox>

                        <VBox styleClass="modal-body" spacing="16">

                            <GridPane hgap="16" vgap="14" maxWidth="Infinity">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <HBox spacing="2">
                                        <Label text="First Name" styleClass="form-label"/>
                                        <Label text=" *" style="-fx-text-fill: #ef4444;"/>
                                    </HBox>
                                    <TextField fx:id="userFirstNameField"
                                               styleClass="form-field" maxWidth="Infinity"
                                               promptText="John"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <HBox spacing="2">
                                        <Label text="Last Name" styleClass="form-label"/>
                                        <Label text=" *" style="-fx-text-fill: #ef4444;"/>
                                    </HBox>
                                    <TextField fx:id="userLastNameField"
                                               styleClass="form-field" maxWidth="Infinity"
                                               promptText="Doe"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <HBox spacing="2">
                                        <Label text="Username" styleClass="form-label"/>
                                        <Label text=" *" style="-fx-text-fill: #ef4444;"/>
                                    </HBox>
                                    <TextField fx:id="userUsernameField"
                                               styleClass="form-field" maxWidth="Infinity"
                                               promptText="jdoe"/>
                                    <Label fx:id="usernameConflictError"
                                           styleClass="validation-error"
                                           text="" visible="false" managed="false"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Email" styleClass="form-label"/>
                                    <TextField fx:id="userEmailField"
                                               styleClass="form-field" maxWidth="Infinity"
                                               promptText="john@pharmacy.com"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <HBox spacing="2">
                                        <Label text="Role" styleClass="form-label"/>
                                        <Label text=" *" style="-fx-text-fill: #ef4444;"/>
                                    </HBox>
                                    <ComboBox fx:id="userRoleCombo"
                                              styleClass="combo-box" maxWidth="Infinity"
                                              prefHeight="42" promptText="Select role"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                      alignment="BOTTOM_LEFT">
                                    <CheckBox fx:id="userActiveCheck"
                                              text="Account Active"
                                              style="-fx-font-size: 14px;"
                                              selected="true"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <HBox spacing="2">
                                        <Label text="Password" styleClass="form-label"/>
                                        <Label fx:id="passwordRequiredStar"
                                               text=" *" style="-fx-text-fill: #ef4444;"/>
                                    </HBox>
                                    <PasswordField fx:id="userPasswordField"
                                                   styleClass="form-field" maxWidth="Infinity"
                                                   promptText="Min. 8 characters"/>
                                    <Label fx:id="passwordStrengthLabel"
                                           text="" styleClass="caption-text"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="Confirm Password" styleClass="form-label"/>
                                    <PasswordField fx:id="userConfirmPasswordField"
                                                   styleClass="form-field" maxWidth="Infinity"
                                                   promptText="Repeat password"/>
                                    <Label fx:id="passwordMatchError"
                                           styleClass="validation-error"
                                           text="" visible="false" managed="false"/>
                                </VBox>

                            </GridPane>

                            <!-- Permissions Note -->
                            <HBox style="-fx-background-color: #eff6ff; -fx-background-radius: 8px; -fx-padding: 10px 14px;"
                                  spacing="10" alignment="CENTER_LEFT">
                                <Label text="ℹ" style="-fx-font-size: 16px; -fx-text-fill: #3b82f6;"/>
                                <Label text="Permission scopes are controlled by role assignment. Contact system admin to modify roles."
                                       styleClass="caption-text"
                                       wrapText="true"
                                       HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <!-- Global error -->
                            <Label fx:id="userFormError"
                                   styleClass="validation-error"
                                   text="" visible="false" managed="false"/>

                        </VBox>

                        <HBox styleClass="modal-footer"
                              alignment="CENTER_RIGHT" spacing="12">
                            <Button fx:id="cancelUserBtn"
                                    text="Cancel"
                                    styleClass="btn-secondary"
                                    onAction="#closeUserModal"
                                    cancelButton="true"/>
                            <Button fx:id="saveUserBtn"
                                    text="💾  Save User"
                                    styleClass="btn-primary"
                                    defaultButton="true"
                                    onAction="#saveUser"/>
                        </HBox>

                    </VBox>
                </StackPane>

            </StackPane>
        </Tab>

    </TabPane>

</VBox>
