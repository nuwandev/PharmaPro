<?xml version="1.0" encoding="UTF-8"?>

<!--
    PharmaPro – Supplier Management Screen
    Controller: com.nuwandev.pharmapro.ui.SupplierController
-->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane
        xmlns:fx="http://javafx.com/fxml/1"
        xmlns="http://javafx.com/javafx/17"
        fx:controller="com.nuwandev.pharmapro.ui.SupplierController"
        fx:id="supplierRoot"
        style="-fx-background-color: #f5f5f5;"
        stylesheets="@css/pharmapro.css">

    <!-- ══ Main Content ══════════════════════════════════════ -->
    <VBox spacing="0">

        <!-- Toolbar -->
        <HBox fx:id="supplierToolbar"
              spacing="12"
              alignment="CENTER_LEFT"
              style="-fx-padding: 0 0 16px 0;">

            <StackPane alignment="CENTER_LEFT">
                <TextField fx:id="supplierSearchField"
                           styleClass="search-field"
                           promptText="Search by name, phone, or email…"
                           prefWidth="300"/>
                <Label text="🔍"
                       style="-fx-padding: 0 0 0 10px; -fx-font-size: 13px; -fx-text-fill: #9ca3af;"
                       mouseTransparent="true"/>
            </StackPane>

            <ComboBox fx:id="supplierStatusFilter"
                      styleClass="combo-box"
                      promptText="All Statuses"
                      prefWidth="140" prefHeight="42"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="supplierCountLabel"
                   text="0 suppliers"
                   styleClass="caption-text"/>

            <Button fx:id="addSupplierBtn"
                    text="＋  Add Supplier"
                    styleClass="btn-primary"
                    onAction="#openAddSupplier"/>

        </HBox>

        <!-- Supplier Table Card -->
        <VBox styleClass="card" spacing="0" VBox.vgrow="ALWAYS">

            <TableView fx:id="supplierTable"
                       styleClass="table-view"
                       VBox.vgrow="ALWAYS"
                       prefHeight="560">
                <placeholder>
                    <Label text="No suppliers found. Click '+ Add Supplier' to get started."/>
                </placeholder>
                <columns>

                    <TableColumn fx:id="supplierNameCol"
                                 text="SUPPLIER NAME"
                                 prefWidth="200" minWidth="140"/>

                    <TableColumn fx:id="supplierContactPersonCol"
                                 text="CONTACT PERSON"
                                 prefWidth="160" minWidth="120"/>

                    <TableColumn fx:id="supplierPhoneCol"
                                 text="PHONE"
                                 prefWidth="130" minWidth="100"/>

                    <TableColumn fx:id="supplierEmailCol"
                                 text="EMAIL"
                                 prefWidth="200" minWidth="150"/>

                    <TableColumn fx:id="supplierAddressCol"
                                 text="ADDRESS"
                                 prefWidth="200" minWidth="140"/>

                    <TableColumn fx:id="supplierStatusCol"
                                 text="STATUS"
                                 prefWidth="100" minWidth="80"/>

                    <TableColumn fx:id="supplierActionsCol"
                                 text="ACTIONS"
                                 prefWidth="140" minWidth="120"
                                 sortable="false" resizable="false"/>

                </columns>
            </TableView>

            <!-- Footer -->
            <HBox alignment="CENTER"
                  spacing="16"
                  style="-fx-padding: 12px 16px; -fx-border-color: #f3f4f6 transparent transparent transparent; -fx-border-width: 1px 0 0 0;">
                <Label fx:id="supplierPaginationInfo"
                       text="Page 1 of 1"
                       styleClass="caption-text"
                       HBox.hgrow="ALWAYS"/>
                <Pagination fx:id="supplierPagination"
                            pageCount="1" currentPageIndex="0"
                            maxPageIndicatorCount="5"/>
            </HBox>

        </VBox>

    </VBox>

    <!-- ══ ADD/EDIT SUPPLIER MODAL ═══════════════════════════════ -->
    <StackPane fx:id="supplierModalOverlay"
               styleClass="modal-overlay"
               visible="false"
               managed="false">

        <VBox fx:id="supplierDialog"
              styleClass="modal-dialog"
              spacing="0"
              maxWidth="560">

            <!-- Header -->
            <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="0">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label fx:id="supplierModalTitle"
                           text="Add New Supplier"
                           styleClass="title-small"/>
                    <Label text="Fill in contact details for this supplier."
                           styleClass="caption-text"/>
                </VBox>
                <Button fx:id="closeSupplierModalBtn"
                        text="✕"
                        styleClass="drawer-close-btn"
                        onAction="#closeSupplierModal"/>
            </HBox>

            <!-- Body -->
            <VBox styleClass="modal-body" spacing="16">

                <GridPane hgap="16" vgap="14" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>

                    <!-- Company / Supplier Name -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          GridPane.columnSpan="2">
                        <HBox spacing="2">
                            <Label text="Supplier / Company Name" styleClass="form-label"/>
                            <Label text=" *" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <TextField fx:id="supplierNameField"
                                   styleClass="form-field"
                                   promptText="e.g. MedLine Distributors Ltd."
                                   maxWidth="Infinity"/>
                        <Label fx:id="supplierNameError"
                               styleClass="validation-error"
                               text="" visible="false" managed="false"/>
                    </VBox>

                    <!-- Contact Person -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Contact Person" styleClass="form-label"/>
                        <TextField fx:id="supplierContactField"
                                   styleClass="form-field"
                                   promptText="Full name"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <!-- Phone -->
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <HBox spacing="2">
                            <Label text="Phone Number" styleClass="form-label"/>
                            <Label text=" *" style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"/>
                        </HBox>
                        <TextField fx:id="supplierPhoneField"
                                   styleClass="form-field"
                                   promptText="+1 (555) 000-0000"
                                   maxWidth="Infinity"/>
                        <Label fx:id="supplierPhoneError"
                               styleClass="validation-error"
                               text="" visible="false" managed="false"/>
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Email Address" styleClass="form-label"/>
                        <TextField fx:id="supplierEmailField"
                                   styleClass="form-field"
                                   promptText="orders@supplier.com"
                                   maxWidth="Infinity"/>
                        <Label fx:id="supplierEmailError"
                               styleClass="validation-error"
                               text="" visible="false" managed="false"/>
                    </VBox>

                    <!-- Website -->
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Website" styleClass="form-label"/>
                        <TextField fx:id="supplierWebsiteField"
                                   styleClass="form-field"
                                   promptText="https://supplier.com"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <!-- Address -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3"
                          GridPane.columnSpan="2">
                        <Label text="Address" styleClass="form-label"/>
                        <TextArea fx:id="supplierAddressField"
                                  styleClass="form-textarea"
                                  promptText="Street, City, State, ZIP"
                                  wrapText="true"
                                  prefRowCount="2"/>
                    </VBox>

                    <!-- Tax / Registration Number -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <Label text="Tax / Reg Number" styleClass="form-label"/>
                        <TextField fx:id="supplierTaxNumberField"
                                   styleClass="form-field"
                                   promptText="Optional"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <!-- Payment Terms -->
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <Label text="Payment Terms" styleClass="form-label"/>
                        <ComboBox fx:id="paymentTermsCombo"
                                  styleClass="combo-box"
                                  promptText="e.g. Net 30"
                                  maxWidth="Infinity"
                                  editable="true"/>
                    </VBox>

                    <!-- Status -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="5">
                        <Label text="Status" styleClass="form-label"/>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <RadioButton fx:id="supplierActiveRadio"
                                         text="Active"
                                         selected="true"
                                         style="-fx-font-size: 14px;"/>
                            <RadioButton fx:id="supplierInactiveRadio"
                                         text="Inactive"
                                         style="-fx-font-size: 14px;"/>
                        </HBox>
                    </VBox>

                    <!-- Preferred Supplier -->
                    <VBox spacing="4"
                          GridPane.columnIndex="1" GridPane.rowIndex="5"
                          alignment="BOTTOM_LEFT">
                        <CheckBox fx:id="preferredSupplierCheck"
                                  text="Mark as Preferred Supplier"
                                  style="-fx-font-size: 14px;"/>
                    </VBox>

                </GridPane>

                <!-- Notes -->
                <VBox spacing="4">
                    <Label text="Notes" styleClass="form-label"/>
                    <TextArea fx:id="supplierNotesField"
                              styleClass="form-textarea"
                              promptText="Any additional notes about this supplier…"
                              wrapText="true"
                              prefRowCount="2"/>
                </VBox>

                <!-- Global error -->
                <Label fx:id="supplierFormError"
                       styleClass="validation-error"
                       text=""
                       visible="false" managed="false"/>

            </VBox>

            <!-- Footer -->
            <HBox styleClass="modal-footer"
                  alignment="CENTER_RIGHT"
                  spacing="12">
                <Button fx:id="cancelSupplierBtn"
                        text="Cancel"
                        styleClass="btn-secondary"
                        onAction="#closeSupplierModal"
                        cancelButton="true"/>
                <Button fx:id="saveSupplierBtn"
                        text="💾  Save Supplier"
                        styleClass="btn-primary"
                        defaultButton="true"
                        onAction="#saveSupplier"/>
            </HBox>

        </VBox>
    </StackPane>

    <!-- ══ DELETE CONFIRM DIALOG ════════════════════════════════ -->
    <StackPane fx:id="deleteConfirmOverlay"
               styleClass="modal-overlay"
               visible="false"
               managed="false">
        <VBox styleClass="modal-dialog"
              spacing="0"
              maxWidth="400">
            <VBox styleClass="modal-header">
                <Label text="Delete Supplier?" styleClass="title-small"/>
            </VBox>
            <VBox styleClass="modal-body" spacing="12">
                <Label fx:id="deleteConfirmMessage"
                       text="Are you sure you want to delete this supplier? This action cannot be undone."
                       styleClass="body-text"
                       wrapText="true"/>
            </VBox>
            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="cancelDeleteBtn"
                        text="Cancel"
                        styleClass="btn-secondary"
                        onAction="#cancelDelete"
                        cancelButton="true"/>
                <Button fx:id="confirmDeleteBtn"
                        text="Delete"
                        styleClass="btn-danger"
                        onAction="#confirmDelete"
                        defaultButton="true"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
