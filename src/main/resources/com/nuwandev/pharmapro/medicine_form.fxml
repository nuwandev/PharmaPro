<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nuwandev.pharmapro.ui.MedicineFormController" spacing="16"
      style="-fx-padding: 24;" minWidth="420">
    <fx:define>
        <ToggleGroup fx:id="statusGroup"/>
    </fx:define>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="formTitleLabel" text="Add/Edit Medicine" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeFormBtn" text="✕" onAction="#closeForm" styleClass="btn-icon"/>
    </HBox>
    <GridPane hgap="12" vgap="10">
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="medicineNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Brand:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="brandField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Category:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Unit:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="unitCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Barcode:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="barcodeField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <HBox spacing="8" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <RadioButton fx:id="statusActiveRadio" text="Active" toggleGroup="$statusGroup" selected="true"/>
            <RadioButton fx:id="statusInactiveRadio" text="Inactive" toggleGroup="$statusGroup"/>
        </HBox>
        <Label text="Description:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionField" GridPane.rowIndex="6" GridPane.columnIndex="1" prefRowCount="2"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Cancel" onAction="#closeForm"/>
        <Button fx:id="saveMedicineBtn" text="Save" onAction="#saveMedicine" styleClass="btn-primary"/>
    </HBox>
</VBox>
